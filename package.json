{
  "name": "steady-ai-backend",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test:mcp": "node --import tsx --test test/apps-mcp.test.ts",
    "cache:exercise-media": "tsx src/scripts/cache-exercise-media.ts",
    "seed:exercise-media": "tsx src/scripts/seed-exercise-media.ts",
    "seed:meal-templates": "tsx src/scripts/seed-meal-templates.ts",
    "upload:exercise-media": "tsx src/scripts/upload-exercise-media.ts",
    "seed:store": "tsx src/scripts/seed-store-catalog.ts",
    "test:integration": "NODE_ENV=test DATABASE_URL=$TEST_DATABASE_URL DIRECT_URL=${TEST_DIRECT_URL:-$TEST_DATABASE_URL} node --import tsx --test test/integration/api.integration.test.ts",
    "test:e2e": "node --env-file-if-exists=.env.test --import tsx --test --test-concurrency=1 --test-reporter=spec \"test/e2e/**/*.test.ts\"",
    "test:e2e:tier1": "node --env-file-if-exists=.env.test --import tsx --test --test-concurrency=1 --test-reporter=spec \"test/e2e/tier1-features/*.test.ts\"",
    "test:e2e:tier2": "node --env-file-if-exists=.env.test --import tsx --test --test-concurrency=1 --test-reporter=spec \"test/e2e/tier2-boundaries/*.test.ts\"",
    "test:e2e:tier3": "node --env-file-if-exists=.env.test --import tsx --test --test-concurrency=1 --test-reporter=spec \"test/e2e/tier3-cross-feature/*.test.ts\"",
    "test:e2e:tier4": "node --env-file-if-exists=.env.test --import tsx --test --test-concurrency=1 --test-reporter=spec \"test/e2e/tier4-workflows/*.test.ts\"",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev"
  },
  "dependencies": {
    "@fastify/cors": "^11.2.0",
    "@fastify/formbody": "^8.0.2",
    "@fastify/multipart": "^9.0.3",
    "@prisma/client": "^6.19.3",
    "dotenv": "^16.4.5",
    "fastify": "^5.8.5",
    "prisma": "^6.19.3",
    "tsx": "^4.19.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.5",
    "typescript": "^5.7.3"
  }
}
